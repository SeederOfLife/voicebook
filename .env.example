# Copy to .env.local for local dev, or add in Vercel → Project → Settings → Environment Variables.

# Nothing here is required: without any key the app reads in the studio voice,
# generated on this server (see README: "The studio voice and its monthly allowance").

# ---- Studio voice ----
# STUDIO_MONTHLY_HOURS=3                # per-device allowance in CPU-hours; 0 = no limit
# STUDIO_VOICE=off                      # switch the studio voice off
# KOKORO_MODEL=fp32                     # fp32 (best) or q8 (smaller)

# ---- AI analysis (genre, characters, emotions, scenes, sound effects) ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5      # claude-sonnet-5-5 = better character detection

# ---- Acting voices that perform each line (optional) ----
ELEVENLABS_API_KEY=                     # also enables sound effects
# ELEVENLABS_MODEL=eleven_v3
# ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v3
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- Personal mode: protect the app with a password ----
APP_PASSWORD=

# ---- Accounts mode — everything is free and open unless PAYWALL=on AND the three Supabase values are set ----
# PAYWALL=on
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PREMIUM_EMAILS=                         # your email(s): always Premium

# ---- Payments (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- AI for characters, emotions and casting (optional, either one) ---
# Free: create a key at https://aistudio.google.com (Get API key). Used first when set.
GEMINI_API_KEY=
# Optional: which Gemini model(s) to try, comma-separated
# GEMINI_MODEL=gemini-flash-latest,gemini-2.5-flash
